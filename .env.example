# Copy this file to .env and fill in the values. .env is git-ignored.
# Never commit real values, and never paste them into chat.

# From @BotFather in Telegram (/newbot)
TELEGRAM_BOT_TOKEN=

# Your numeric Telegram ID from @userinfobot (comma-separated for several)
ALLOWED_USER_IDS=

# anthropic | groq | gemini | openrouter | ollama
LLM_PROVIDER=anthropic

# Key for the provider above (not needed for ollama).
# For anthropic, ANTHROPIC_API_KEY also works.
LLM_API_KEY=

# Required for every provider except anthropic (free-tier model names change,
# so there is no default). Optional for anthropic.
SUMMARY_MODEL=
NARRATIVE_MODEL=

# Optional
STYLE_SAMPLES=3
DB_PATH=./data/journal.db
