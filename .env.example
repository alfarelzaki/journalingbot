# Copy this file to .env and fill in the values. .env is git-ignored.
# Never commit real values, and never paste them into chat.
# Write values WITHOUT quotes: Docker's --env-file keeps quotes literally.

# From @BotFather in Telegram (/newbot)
TELEGRAM_BOT_TOKEN=

# Your numeric Telegram ID from @userinfobot (comma-separated for several)
ALLOWED_USER_IDS=

# anthropic | deepseek | groq | gemini | openrouter | ollama
LLM_PROVIDER=anthropic

# Key for the provider above (not needed for ollama).
# For anthropic, ANTHROPIC_API_KEY also works.
LLM_API_KEY=

# SUMMARY_MODEL = the AI model that writes your daily summary.
#   Required for every provider except anthropic (model names change often,
#   so there is no built-in default). Example for DeepSeek: deepseek-flash
# NARRATIVE_MODEL = the model for weekly and monthly recaps.
#   Optional: if left empty it reuses SUMMARY_MODEL.
SUMMARY_MODEL=
NARRATIVE_MODEL=

# --- Optional. Leave these commented out unless you need them. ---
# An empty value is NOT the same as an unset one under Docker --env-file.

# How many daily database backups to keep (default 14).
# BACKUPS_KEPT=14

# 0-3 earlier messages used only as a writing-style sample (default 3).
# STYLE_SAMPLES=3

# Override the provider's API address (e.g. a remote Ollama).
# LLM_BASE_URL=

# Where the database lives. Docker already sets this to /data/journal.db;
# only set it when running outside Docker.
# DB_PATH=./data/journal.db
